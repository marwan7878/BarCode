@model BarCode.Models.Product

@{
    ViewData["Title"] = "Search";
}

<div class="container mt-5">
    <h1 class="mb-4">Search Product</h1>

    <!-- Upload Barcode Image -->
    <div class="card mb-4">
        <div class="card-header">
            <strong>Scan Barcode</strong>
        </div>
        <div class="card-body">
            <form id="barcodeForm" enctype="multipart/form-data">
                <div class="row mb-3">
                    <div class="col-sm-9">
                        <input type="file" id="image" name="image" accept="image/*" class="form-control">
                    </div>
                    <button type="submit" class="col-sm-3 btn btn-primary">Search</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Read-Only Product Details -->
    <div id="productFormContainer" class="d-none">
        <input type="hidden" id="Id" value="@Model?.Id" />

        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Product Details</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label">Name</label>
                    <input class="form-control" id="Name" value="@Model?.Name" readonly />

                    <label class="form-label mt-3">Quantity</label>
                    <div class="input-group" style="max-width: 200px;">
                        <button type="button" class="btn btn-outline-secondary" onclick="changeQuantity(-1)">
                            <i class="bi bi-dash-lg"></i>
                        </button>
                        <input class="form-control text-center" id="Quantity" type="number" value="@Model?.Quantity" readonly />
                        <button type="button" class="btn btn-outline-secondary" onclick="changeQuantity(1)">
                            <i class="bi bi-plus-lg"></i>
                        </button>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Barcode</label>
                    <input class="form-control" id="Barcode" value="@Model?.Barcode" readonly />
                </div>

                <div class="mb-3">
                    <label class="form-label">Created At</label>
                    <input class="form-control" id="CreatedAt" type="datetime-local" value="@Model?.CreatedAt.ToString("yyyy-MM-ddTHH:mm")" readonly />
                </div>

                <a id="editBtn" class="btn btn-primary">Edit</a>
                <a id="deleteBtn" class="btn btn-danger">Delete</a>

            </div>
        </div>
    </div>

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </div>
</div>

<!-- JavaScript -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    function changeQuantity(amount) {
        const input = document.getElementById('Quantity');
        let value = parseInt(input.value) || 0;
        value = Math.max(0, value + amount); // prevent going below 0
        input.value = value;
        const id = document.getElementById('Id');
        $.ajax({
                url: '/products/UpdateQuantity',
                type: 'POST',
                data: { id : id.value ,quantity : input.value },
                
            });
    }
    
    async function uploadAndFetchProduct(formData) {
        return new Promise((resolve, reject) => {
            $.ajax({
                url: '/products/BarcodeSearch',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: resolve,
                error: reject
            });
        });
    }

    $('#barcodeForm').on('submit', async function (e) {
        e.preventDefault();

        const file = $('#image')[0].files[0];

        if (!file) {
            alert("Please choose a file.");
            return;
        }

        const formData = new FormData();
        formData.append("barcode", file);

        try {
            const data = await uploadAndFetchProduct(formData);
            const product = data.result;

            if (!product) {
                alert("Product not found.");
                return;
            }

            // Fill form fields
            $('#Id').val(product.id);
            $('#Name').val(product.name);
            $('#Barcode').val(product.barcode);
            $('#Quantity').val(product.quantity);
            $('#CreatedAt').val(new Date(product.createdAt).toISOString().slice(0, 16));

            // Set Edit/Delete URLs
            $('#editBtn').attr('href', `/products/Edit/${product.id}`);
            $('#deleteBtn').attr('href', `/products/Delete/${product.id}`);

            $('#productFormContainer').removeClass('d-none');
        } catch (error) {
            console.error("Error:", error);
        }
    });
</script>
